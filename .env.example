# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill it in. `.env` is git-ignored: never commit
# it, never paste its contents into an AI chat, a screenshot or a ticket.
#
#   cp .env.example .env
#
# FAIL-FAST RULE (src/config.ts): the app refuses to start with a clear message
# if a required variable is missing. Some variables are only required when the
# feature they belong to is switched on:
#
#   * always required: SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY
#   * if ANY variable of a group below is filled, the WHOLE group is required
#     (e.g. setting LLM_API_KEY without LLM_PROVIDER is an error, not a warning)
#   * NODE_ENV=production additionally requires PUBLIC_BASE_URL and
#     ENCRYPTION_KEY (see the bottom of this file)
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=                 # https URL Meta can reach (tunnel in dev)

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=               # dashboard only

META_APP_SECRET=                 # for webhook signature check
META_VERIFY_TOKEN=               # random string you invent (min 16 chars); same value goes in Meta dashboard
GRAPH_API_VERSION=               # use the current version from Meta docs [VERIFY]
WA_PHONE_NUMBER_ID=              # demo/single-client mode
WA_TOKEN=                        # permanent system-user token (demo mode)
ENCRYPTION_KEY=                  # base64, 32 bytes; encrypts per-client tokens in DB

LLM_PROVIDER=                    # gemini | anthropic | openai | fake (fake = canned replies, free, for local dev)
LLM_API_KEY=
LLM_MODEL=                       # small, fast model; name from provider docs

STT_PROVIDER=                    # openai-whisper | gemini | google | sarvam | fake (fake = canned transcript)
STT_API_KEY=

TELEGRAM_BOT_TOKEN=              # optional staff alerts
TELEGRAM_CHAT_ID=

GOOGLE_SERVICE_ACCOUNT_EMAIL=   # service account email (clients share their sheet with this)
GOOGLE_PRIVATE_KEY=             # from the service account JSON key; handle \n newlines
SHEETS_SYNC_INTERVAL_SECONDS=10

DEBOUNCE_SECONDS=3
MAX_VOICE_BYTES=1500000          # rough cap; tune after tests
QUIET_HOURS_START=22:00
QUIET_HOURS_END=07:00

# live = real Meta sends. console = fake sends for testing while Meta delivery
# is unavailable: the would-be reply is printed to stdout (never to the logs)
# and the out row is still saved with a fake wamid. Console mode works for the
# demo client ONLY; any other client is refused with an error.
SEND_MODE=live

# --- Slice 4: reply worker + LLM brain ---------------------------------------
# The worker answers queued reply jobs. Needs the LLM_* trio below (all three
# or none); without it the webhook still runs but the worker does not start.
WORKER_ENABLED=true
WORKER_POLL_MS=1000               # pause between queue polls
WORKER_CONCURRENCY=2              # jobs processed at the same time
LLM_TIMEOUT_MS=20000              # per LLM call, incl. retries
LLM_MAX_OUTPUT_TOKENS=400         # caps reply length and cost
# More than RATE_LIMIT_MESSAGES inbound from one phone per RATE_LIMIT_WINDOW_SECONDS
# -> no LLM call, one "please slow down" notice per 10 minutes max.
RATE_LIMIT_MESSAGES=20
RATE_LIMIT_WINDOW_SECONDS=60
# Max LLM calls per client per UTC day. Over it -> fallback reply + needs_staff.
MAX_LLM_CALLS_PER_CLIENT_PER_DAY=2000
# Do not send the same fallback text twice within this many seconds.
FALLBACK_COOLDOWN_SECONDS=600
# Optional $/MTok for usage_log.est_cost (defaults: gemini-3.8-flash paid prices
# through Dec 2026). Free-tier tokens cost nothing either way.
LLM_PRICE_IN_PER_MTOK=0.75
LLM_PRICE_OUT_PER_MTOK=3.75

# Not in the spec's list, added in Slice 0: pino log verbosity.
# silent | fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- required only when NODE_ENV=production ---------------------------------
# PUBLIC_BASE_URL=https://wa.example.com
# ENCRYPTION_KEY: generate with `openssl rand -base64 32`
