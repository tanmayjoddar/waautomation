{
  "name": "wa-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multi-tenant WhatsApp AI receptionist (text + voice notes) for small businesses in India",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx scripts/seed.ts",
    "chat": "tsx scripts/chat.ts",
    "env:check": "tsx scripts/check-env-keys.ts",
    "simulate:webhook": "tsx scripts/simulate-webhook.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "express": "^5.1.0",
    "pino": "^9.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^5.0.3"
  }
}
